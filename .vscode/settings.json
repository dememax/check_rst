// VS Code workspace defaults — check_rst project
{
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.rulers": [120],

    "python.defaultInterpreterPath": "/usr/bin/python3.14",
    "python-envs.terminal.autoActivationType": "off",
    "python.analysis.extraPaths": ["${workspaceFolder}/src"],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],
    "python.testing.cwd": "${workspaceFolder}",

    // Ruff discovers pyproject.toml itself; make the repository configuration
    // authoritative if an editor-level Ruff configuration also exists.
    "ruff.configurationPreference": "filesystemFirst",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },

    "restructuredtext": {
        "preview.fontSize": 18,
        "linter.run": "onSave",
        "preview.autoShow": true,
        "confPath": "docs/conf.py",
        "sphinxBuildArgs": ["-n", "-v"],
        "sphinxBuildPath": "/tmp/vscode-build/check_rst"
    },

    "markdown": {
        "preview.fontSize": 18,
        "preview.scrollEditorWithPreview": true
    },

    "cSpell.words": [
        "autosectionlabel",
        "check_rst",
        "DEMENTYEV",
        "dememax",
        "docname",
        "docutils",
        "Maxime",
        "mypy",
        "pytest",
        "reStructuredText",
        "snowballstemmer",
        "SPDX",
        "Sphinx",
        "toctree"
    ]
}
